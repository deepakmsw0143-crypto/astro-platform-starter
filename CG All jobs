import React, { useEffect, useMemo, useRef, useState } from "react"; import { motion } from "framer-motion"; import { Search, LogOut, Upload, Download, Eye, ShieldCheck, Users } from "lucide-react"; import { Card, CardContent } from "@/components/ui/card"; import { Button } from "@/components/ui/button"; import { Input } from "@/components/ui/input"; import { Textarea } from "@/components/ui/textarea";

// ---- Firebase SDK (install via npm: firebase) ---- // npm i firebase import { initializeApp } from "firebase/app"; import { getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword, onAuthStateChanged, signOut, } from "firebase/auth"; import { getFirestore, doc, setDoc, getDoc, collection, query, orderBy, limit as qlimit, startAfter, getDocs, serverTimestamp, } from "firebase/firestore";

